<?xml version="1.0" encoding="utf-8"?>
<!-- Timer antrian NEGATIF: order Tertunda/Terjadwal muncul lebih awal (jam buka cabang), menghitung
     mundur ke jam yang diminta pelanggan — belum "menunggu", jadi warnanya beda dari netral/kuning/
     merah (bg_queue_timer_ok/warn/danger). Biru (sky-700 #0369A1, cermin web) supaya jelas dibaca
     "terjadwal", bukan "sudah lama di antrean". -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0369A1" />
    <corners android:radius="11dp" />
    <stroke android:width="1.5dp" android:color="#FFFFFF" />
</shape>
