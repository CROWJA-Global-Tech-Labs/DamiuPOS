<?xml version="1.0" encoding="utf-8"?>
<!-- Latar jendela dialog "tampilan baru" (hanya lewat ThemeOverlay.DAMIUPOS.Gojek): inset sama dengan
     abc_dialog_material_background (16dp) tapi sudut 16dp seperti dialog Gojek. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetTop="16dp"
    android:insetRight="16dp"
    android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="16dp" />
        <solid android:color="@color/gj_surface" />
    </shape>
</inset>
