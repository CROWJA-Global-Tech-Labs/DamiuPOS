<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DAMIUPOS" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- App is intentionally Light-only (no values-night/, no DayNight). Opt out of the
             OS "force dark" auto-inversion (aggressive on Samsung One UI) so the struk PNG
             capture — and every screen — keeps its real light colors instead of being inverted
             to a solid dark/gray image. No-op below API 29. -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <!-- Default toolbar title color: white on primary background -->
        <item name="toolbarStyle">@style/DAMIUToolbar</item>
        <item name="titleTextColor">@color/white</item>
        <item name="actionMenuTextColor">@color/white</item>
        <!-- White 3-dot overflow icon on primary-colored toolbar -->
        <item name="actionOverflowButtonStyle">@style/DAMIUOverflowButton</item>
        <!-- Darker default background for all input fields (TextInputLayout/EditText) -->
        <item name="textInputStyle">@style/DAMIUTextInputLayout</item>
        <item name="editTextStyle">@style/DAMIUEditText</item>
        <item name="android:editTextStyle">@style/DAMIUEditText</item>
    </style>

    <!-- Tint the overflow (3-dot) icon white so it reads on the primary toolbar -->
    <style name="DAMIUOverflowButton" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">@color/white</item>
        <item name="tint">@color/white</item>
    </style>

    <!-- Material outlined-box input: visible border at all times + darker fill -->
    <style name="DAMIUTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/input_field_bg</item>
        <item name="boxStrokeColor">@color/input_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- Plain EditText (non-Material) — give it the same darker fill -->
    <style name="DAMIUEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@color/input_field_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="DAMIUToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="android:background">@color/primary</item>
        <!-- Make sure action/overflow icons inherit white tint on the primary toolbar -->
        <item name="android:theme">@style/DAMIUToolbarOverlay</item>
    </style>

    <!-- Overlay that forces the toolbar's icon color (nav + overflow) to white -->
    <style name="DAMIUToolbarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Sel statistik header layar "Pelanggan Promosi" (angka + label di atas warna primary). -->
    <style name="PromoStatCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="PromoStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PromoStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#D6FFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
