<?xml version="1.0" encoding="utf-8"?>
<!-- Tema "Tampilan Baru (gaya Gojek)". Dua bagian:
     1. Theme.DAMIUPOS.Gojek — tema PENUH untuk layar baru (AdminHomeActivity), dipasang lewat manifest.
     2. ThemeOverlay.DAMIUPOS.Gojek — overlay yang ditumpuk ke SEMUA layar lama saat admin memakai tampilan
        baru (DamiuApplication → GojekUi.applyOverlay), supaya warna/bentuk ikut Gojek tanpa menyentuh tiap layar.
     Non-admin tak pernah mendapat keduanya. -->
<resources>

    <style name="Theme.DAMIUPOS.Gojek" parent="Theme.DAMIUPOS">
        <item name="colorPrimary">@color/gj_primary</item>
        <item name="colorPrimaryDark">@color/gj_brand</item>
        <item name="colorAccent">@color/gj_primary</item>
        <item name="colorSecondary">@color/gj_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorControlActivated">@color/gj_primary</item>
        <item name="android:statusBarColor">@color/gj_brand</item>
        <item name="android:navigationBarColor">@color/gj_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/gj_surface</item>
        <item name="android:textColorPrimary">@color/gj_text_primary</item>
        <item name="android:textColorSecondary">@color/gj_text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.Gj.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Gj.Card</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Gj.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Gj.Dialog</item>
    </style>

    <!-- Overlay untuk layar lama (diisi lebih lanjut oleh pekerjaan tema global). -->
    <style name="ThemeOverlay.DAMIUPOS.Gojek" parent="">
        <item name="colorPrimary">@color/gj_primary</item>
        <item name="colorPrimaryDark">@color/gj_primary</item>
        <item name="colorAccent">@color/gj_primary</item>
        <item name="colorSecondary">@color/gj_primary</item>
        <item name="colorControlActivated">@color/gj_primary</item>
        <item name="android:statusBarColor">@color/gj_primary</item>
    </style>

    <!-- Tombol pil (sudut = setengah tinggi), tebal, tanpa huruf kapital, tanpa bayangan. -->
    <style name="Widget.Gj.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/gj_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Gj.Button.Tonal" parent="Widget.Gj.Button">
        <item name="backgroundTint">@color/gj_primary_container</item>
        <item name="android:textColor">@color/gj_on_primary_container</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Widget.Gj.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/gj_primary</item>
        <item name="android:textColor">@color/gj_primary</item>
    </style>

    <style name="Widget.Gj.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/gj_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/gj_surface</item>
    </style>

    <style name="ThemeOverlay.Gj.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/gj_primary</item>
        <item name="colorAccent">@color/gj_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Gj.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Gj.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Gj.DialogButton</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Gj.Dialog</item>
    </style>

    <style name="Widget.Gj.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/gj_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.Gj.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Skala huruf (Asphalt): judul tebal, isi biasa; tanpa tracking. -->
    <style name="TextAppearance.Gj.TitleXL" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gj_text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Gj.TitleL" parent="TextAppearance.Gj.TitleXL">
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TextAppearance.Gj.TitleM" parent="TextAppearance.Gj.TitleXL">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.Gj.TitleS" parent="TextAppearance.Gj.TitleXL">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.Gj.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/gj_text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Gj.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gj_text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Gj.Tag" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
