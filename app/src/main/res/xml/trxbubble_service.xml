<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol melayang "+ Trx": tidak pernah bereaksi terhadap event (bubble hanya membaca layar
     saat DITAP — lihat TrxBubble#onTap), jadi tanpa android:packageNames. Saat ditap, paket
     aplikasi depan diperiksa; isi layar hanya dibaca bila WhatsApp (judul chat saja). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/wa_trxbubble_desc"
    android:notificationTimeout="100" />
