<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- "📍 [Lokasi · ]Wilayah (jarak dari posisi kurir ini)" — TEPAT DI BAWAH nama, hitam pekat.
             Formatnya satu dengan kartu Antrian Delivery (DeliveryQueueActivity.queueLocationLine);
             jarak menyusul begitu GPS memberi fix. GONE bila tak ada wilayah maupun jarak. -->
        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_strong"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/grey_medium"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#F57C00"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- "Pesanan Terbuka" (lelang) belum diklaim — staf perangkat mana pun boleh mengambilnya. -->
        <TextView
            android:id="@+id/tvOpenDispatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#6366F1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Umur pesanan: badge hijau/kuning/merah, berkedip begitu &gt;=1 jam (kuning) / &gt;=2 jam
             (merah, kedip lebih cepat) — live per detik (lihat OtherDeviceQueueActivity.applyQueueTimerState),
             cermin PERSIS badge ⏱ di Antrian Saya sendiri. -->
        <TextView
            android:id="@+id/tvQueued"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_queue_timer_ok_green"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="⏱ 00:00"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- "📝 catatan order" — DISEMATKAN paling bawah ISI kartu (baris tombol tetap paling akhir;
             menaruh catatan di bawah tombol akan mengubur aksinya). Sama dgn kartu ketiga tab di
             Antrian Delivery: penanda pembukuan internal & blob audit order web sudah disaring
             (lihat DeliveryQueueActivity.bindOrderNote / ReceiptActivity.customerNote).
             GONE default → kartu tanpa catatan tingginya persis seperti sebelumnya. -->
        <TextView
            android:id="@+id/tvOrderNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_order_note"
            android:ellipsize="end"
            android:maxLines="3"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/actionsNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavigasi"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Navigasi"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_directions"
                app:iconGravity="textStart" />

            <!-- 💬 Chat WA pelanggan (disembunyikan bila tanpa nomor). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWaChat"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:icon="@drawable/ic_whatsapp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                android:contentDescription="Chat WA"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAmbilAlih"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Ambil Alih"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_share"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
