<?xml version="1.0" encoding="utf-8"?>
<!-- Ubin layanan gaya Gojek: kotak 56dp bersudut 16dp berlatar tint kategori + emoji, label 12sp,
     badge hitungan merah (kanan-atas) atau tag hitam/merah (kiri-atas). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="62dp">

        <FrameLayout
            android:id="@+id/gjhTileBox"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|center_horizontal">

            <TextView
                android:id="@+id/gjhTileEmoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:textSize="26sp" />

            <ImageView
                android:id="@+id/gjhTileImg"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/gjhTileBadge"
            style="@style/GjHome.Badge"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:minWidth="18dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/gjhTileTag"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="top|start"
            android:background="@drawable/gjh_bg_tag"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/gjhTileLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/gj_text_primary"
        android:textSize="12sp" />
</LinearLayout>
