<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu satu produk di layar Pengisian: chip warna, nama, rumus kebutuhan, angka besar "ISI N LAGI",
     bar ready/target, dan tombol cepat isi. Semua warna eksplisit (terbaca terang & gelap). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Chip warna produk (latar polos, BUKAN foto) -->
        <View
            android:id="@+id/vChip"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:background="#607D8B" />

        <!-- Isi kartu rata tengah vertikal: tinggi kartu (minHeight) diatur kode menurut sisa layar,
             kepadatan isi menurut FillLayoutPlan (penuh / sedang / ringkas). -->
        <LinearLayout
            android:id="@+id/cardContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#212121"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#455A64"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="32sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pb"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:max="100" />

            <TextView
                android:id="@+id/tvFilledToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#546E7A"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/rowButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlus1"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="+1"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    app:backgroundTint="#1565C0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlus5"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="+5"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    app:backgroundTint="#1565C0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlus10"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="+10"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    app:backgroundTint="#1565C0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOther"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1.6"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Lainnya…"
                    android:textColor="#1565C0"
                    android:textSize="14sp"
                    app:backgroundTint="#E3F2FD" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
