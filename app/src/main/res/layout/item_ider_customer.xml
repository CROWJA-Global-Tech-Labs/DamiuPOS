<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu Mode Keliling: foto lokasi + nomor urut | nama, jarak, lokasi (multi), badge terakhir beli &
     prediksi order | tombol "+TRX" di kanan (setinggi kartu, sasaran sentuh lebar untuk dipakai di jalan).
     Kontras: #212121/#FFFFFF 16:1 · #0D47A1/#FFFFFF 8,6:1 · #455A64/#FFFFFF 7,2:1 · putih/#2E7D32 5,1:1. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="#E0E0E0"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#CFD8DC"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivIderThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Foto lokasi pelanggan"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvIderRank"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_ider_rank"
                android:elevation="3dp"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIderDist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#0D47A1"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIderSpot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#455A64"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvIderBuy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 🚩 Termasuk Daftar Kunjungan Urgent. #B71C1C di atas #FFEBEE = 5,7:1. -->
            <TextView
                android:id="@+id/tvIderUrgent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="🚩 Kunjungan Urgent"
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvIderReorder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIderTrx"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="52dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="+TRX"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#2E7D32"
                app:cornerRadius="10dp" />

            <!-- Berkedip: pelanggan punya transaksi berjalan hari ini (Penjualan / Ambil Galon).
                 Putih di atas #BF360C = 5,6:1. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIderToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="40dp"
                android:paddingStart="2dp"
                android:paddingTop="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="2dp"
                android:lineSpacingExtra="0dp"
                android:maxLines="2"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#BF360C"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
