<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pesanan akan keluar dari antrian aktif. Saat jadwal ini tiba, pesanan otomatis kembali ke antrian — tanggal transaksi ikut mengikuti jadwal ini."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvTertundaAtLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="🕒 Jadwal Lanjut Otomatis"
        android:textColor="#92400E"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTertundaAt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rounded_field"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupTertundaPreset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:chipSpacingHorizontal="6dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTertunda3h"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+3 jam"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTertundaTomorrow"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Besok"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTertunda15"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Besok 15:00"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTertundaDay2"
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lusa"
            android:textSize="12sp" />
    </com.google.android.material.chip.ChipGroup>

</LinearLayout>
