<?xml version="1.0" encoding="utf-8"?>
<!-- Form Broadcast Terjadwal (buat / ubah) — cermin form web wa/schedules/form. Light-only: label #212121,
     keterangan #455A64 di atas putih (7:1). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEFF1"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            android:theme="@style/DAMIUToolbarOverlay"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
            app:title="Broadcast Baru"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- ============ Pesan & waktu ============ -->
                <LinearLayout
                    android:id="@+id/cardMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama broadcast"
                        android:textColor="#212121"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etName"
                        style="@style/DAMIUEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:hint="mis. Promo Gajian Oktober"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences"
                        android:maxLength="120"
                        android:maxLines="1"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Isi pesan WhatsApp"
                        android:textColor="#212121"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etMessage"
                        style="@style/DAMIUEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="top|start"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="2000"
                        android:minLines="5"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnInsNama"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="+ {nama}"
                            android:textAllCaps="false"
                            android:textColor="#1565C0"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="{nama} diganti nama pelanggan tiap penerima. Pratinjau:"
                            android:textColor="#455A64"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#E8F5E9"
                        android:padding="10dp"
                        android:textColor="#1B5E20"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Waktu broadcast"
                        android:textColor="#212121"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgRepeat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbNone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Sekali saja"
                            android:textColor="#212121" />

                        <RadioButton
                            android:id="@+id/rbWeekdays"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📅 Rutin: hari tertentu tiap minggu"
                            android:textColor="#212121" />

                        <RadioButton
                            android:id="@+id/rbInterval"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🔁 Rutin: tiap N hari sekali"
                            android:textColor="#212121" />
                    </RadioGroup>

                    <LinearLayout
                        android:id="@+id/boxSendAt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSendAtLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kirim pada"
                            android:textColor="#455A64"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnSendAt"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📅 Pilih tanggal &amp; jam"
                            android:textAllCaps="false"
                            android:textColor="#1565C0" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/boxInterval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ulangi tiap"
                            android:textColor="#212121"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etEvery"
                            style="@style/DAMIUEditText"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="hari sekali"
                            android:textColor="#212121"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/boxWeekdays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Setiap hari"
                            android:textColor="#455A64"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cgDays"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <Button
                            android:id="@+id/btnRepeatTime"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🕗 Pukul: pilih jam"
                            android:textAllCaps="false"
                            android:textColor="#1565C0" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="zona waktu Asia/Jakarta"
                        android:textColor="#455A64"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvRepeatHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tiap putaran, pesan dikirim lagi ke SEMUA penerima di daftar. Batalkan broadcast untuk menghentikan pengulangan."
                        android:textColor="#455A64"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ============ Penerima ============ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/white"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSelCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Penerima (0 pelanggan)"
                            android:textColor="#212121"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnClear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:padding="8dp"
                            android:text="Kosongkan"
                            android:textColor="#B71C1C"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <CheckBox
                        android:id="@+id/cbAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="🔄 Otomatis — pelanggan BARU yang lokasi pengirimannya masuk wilayah yang ditambahkan (domisili / batas peta / gambar / Aturan Trip) ikut jadi penerima dengan sendirinya"
                        android:textColor="#212121"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSearch"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="🔍 Cari pelanggan"
                            android:textAllCaps="false"
                            android:textColor="#1565C0"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnArea"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="📍 Per domisili"
                            android:textAllCaps="false"
                            android:textColor="#1565C0"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnMap"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="🗺️ Pilih dari peta"
                            android:textAllCaps="false"
                            android:textColor="#1565C0"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnTrip"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="🚚 Aturan Trip"
                            android:textAllCaps="false"
                            android:textColor="#1565C0"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAreaNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Hanya pelanggan yang punya nomor HP yang ditambahkan massal."
                        android:textColor="#455A64"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/boxAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvAutoTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔄 Wilayah otomatis"
                            android:textColor="#1B5E20"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cgAuto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dicek tiap menit (domisili pelanggan baru terisi otomatis dari koordinatnya). Pelanggan yang Anda keluarkan dari daftar tidak ditambahkan lagi. ✕ = hentikan otomatis untuk wilayah itu (penerima yang sudah ada tetap)."
                            android:textColor="#455A64"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnRecipients"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="👥 Lihat / keluarkan penerima (0)"
                        android:textAllCaps="false"
                        android:textColor="#1565C0" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/tvLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#ECEFF1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="24dp"
            android:text="Memuat…"
            android:textColor="#455A64"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/btnSchedule"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:text="⏰ Jadwalkan"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnDraft"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Simpan draf"
            android:textAllCaps="false"
            android:textColor="#37474F" />
    </LinearLayout>
</LinearLayout>
