<?xml version="1.0" encoding="utf-8"?>
<!-- Satu baris entri produk pada layar Transaksi Baru: nama jenis air +
     harga per pcs (editable) + stepper jumlah (−/+). Semua produk DB
     di-render sebagai baris-baris ini supaya user tidak perlu menambah
     item satu per satu.

     Root MaterialCardView (bukan LinearLayout polos) HANYA untuk bisa mengedipkan
     BORDER kuning pada baris "↩ Terakhir dibeli" (TransactionActivity.startLastBoughtBlink,
     via card.setStrokeColor() — cermin pola kedip border ⚡ PRIORITAS di kartu antrian
     delivery). Elevasi/radius/ripple DIMATIKAN supaya baris tetap terlihat identik dengan
     LinearLayout polos yang lama saat TIDAK berkedip. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:rippleColor="@android:color/transparent"
    app:strokeColor="@android:color/transparent"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvItemDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#1565C0"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <!-- Nama produk + badge "↩ Terakhir dibeli" BERDAMPINGAN (bukan badge di baris
                     tersendiri di bawahnya seperti sebelumnya) — nama tetap dapat jatah lebar
                     fleksibel (weight=1) jadi masih wrap/ellipsize wajar saat badge tampil. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvItemName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text="Jenis Air"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Muncul begitu pelanggan dipilih, untuk produk yang ada di pembelian (JUAL)
                         TERAKHIR-nya (lihat TransactionActivity.highlightLastPurchasedItems). -->
                    <TextView
                        android:id="@+id/tvItemLastBought"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:background="@drawable/bg_badge_wajib"
                        android:text="↩ Terakhir dibeli"
                        android:textColor="#B45309"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="Rp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etItemPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="72dp"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="/pcs"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemMinus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="−"
                android:textAllCaps="false"
                android:textSize="20sp"
                app:cornerRadius="8dp" />

            <EditText
                android:id="@+id/etItemQty"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:maxLines="1"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemPlus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="+"
                android:textAllCaps="false"
                android:textSize="20sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#14000000" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
