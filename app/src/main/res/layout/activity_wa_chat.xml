<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECE5DD"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#075E54"
            android:titleTextColor="@color/white"
            android:subtitleTextColor="#D0E8E4"
            app:navigationIcon="@drawable/ic_arrow_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Indikator komplain: order pelanggan ini ditandai 😠 dalam 30 hari terakhir. -->
    <TextView
        android:id="@+id/tvComplaintBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#C62828"
        android:padding="6dp"
        android:text="😠 Pelanggan ini punya order berstatus KOMPLAIN"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3E0"
        android:padding="6dp"
        android:textColor="#7A3E00"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="6dp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Balasan-kutip -->
    <LinearLayout
        android:id="@+id/replyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F2F5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#E1F3D8"
            android:ellipsize="end"
            android:maxLines="2"
            android:padding="6dp"
            android:textColor="#3B4A54"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnReplyCancel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Panel emoji -->
    <GridView
        android:id="@+id/emojiPanel"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#FFFFFF"
        android:numColumns="8"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F2F5"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/btnEmoji"
            android:layout_width="40dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="😊"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_wa_input"
            android:hint="Ketik pesan"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:minHeight="42dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="📎"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/btnSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_wa_send"
            android:gravity="center"
            android:text="🎤"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
