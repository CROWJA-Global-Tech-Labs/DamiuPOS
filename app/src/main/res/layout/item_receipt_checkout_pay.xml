<?xml version="1.0" encoding="utf-8"?>
<!-- 🧺 Kotak "Bayar per lokasi" struk gambar GABUNGAN — disisipkan ReceiptActivity tepat di bawah
     baris Pembayaran (rcPaymentRow). Keputusan owner: satu metode bayar untuk semua lokasi, tapi
     tiap lokasi DIBAYAR DI PINTUNYA SENDIRI untuk tagihannya sendiri. Baris per lokasi =
     receipt_image_item tanpa titik. Warna sama dengan receipt_image_card (latar putih). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bayar per lokasi"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/rcLegPayRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tiap lokasi dibayar saat pesanannya tiba di lokasi itu."
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="italic" />
</LinearLayout>
