<?xml version="1.0" encoding="utf-8"?>
<!-- Satu tab navigasi bawah gaya Gojek: indikator 3dp di tepi ATAS, ikon 24dp, label 12sp, badge merah. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="56dp"
    android:layout_weight="1"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/gjhNavIndicator"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/gjh_bg_nav_indicator"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="26dp">

            <ImageView
                android:id="@+id/gjhNavIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal|bottom"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/gjhNavBadge"
                style="@style/GjHome.Badge"
                android:layout_gravity="top|end"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/gjhNavLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/gj_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
