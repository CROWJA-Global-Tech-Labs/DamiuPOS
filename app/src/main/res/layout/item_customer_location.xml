<?xml version="1.0" encoding="utf-8"?>
<!-- Satu baris lokasi pelanggan (multi-lokasi). Baris PERTAMA = lokasi utama.
     Styling diangkat dari kartu "Koordinat Lokasi" lama di activity_customer_form. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Nama wajib UNIK per pelanggan — error inline dipasang dari
                 CustomerFormActivity#refreshLocationNameErrors. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLokasiNama"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:hint="Nama Lokasi"
                app:placeholderText="mis: warung, rumah, bengkel"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLokasiNama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHapusLokasi"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="40dp"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Preset nama lokasi: ketuk untuk mengisi kolom nama. Chip diisi dari kode
             (CustomerFormActivity.LOCATION_NAME_PRESETS). -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipgLokasiPreset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:chipSpacingVertical="0dp" />

        <TextView
            android:id="@+id/tvLokasiKoordinat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Belum ada koordinat"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/pbLokasiAkurasiRow"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLokasiSaatIni"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Lokasi Saat Ini"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_menu_mylocation"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPilihPetaRow"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Pilih dari Peta"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_dialog_map"
                app:iconGravity="textStart" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPakaiGmapsRow"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pakai Link Google Maps"
            android:textAllCaps="false"
            app:icon="@android:drawable/ic_menu_share"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBukaMapsRow"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Buka di Google Maps"
            android:textAllCaps="false"
            android:visibility="gone"
            app:icon="@android:drawable/ic_menu_directions"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

        <!-- Wajib Ongkir PER LOKASI: Transaksi Baru auto-set Ongkos Kirim = Per Galon
             bila lokasi tujuan terpilih memiliki flag ini. Nilai default terisi otomatis saat
             baris ditambahkan (lihat CustomerFormActivity#addLocationRow); "Hitung Ongkir" di
             sampingnya hanya membantu keputusan (tangga jarak cabang), tak memaksa nilainya. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbWajibOngkirRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wajib Ongkir (default Ongkos Kirim: Per Galon)"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHitungOngkirRow"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Hitung Ongkir"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:icon="@android:drawable/ic_menu_directions"
                app:iconGravity="textStart"
                app:iconSize="16dp" />
        </LinearLayout>

        <!-- Tarif ongkir/galon lokasi ini — SAMA dengan field "Ongkir/galon lokasi ini" di web
             (customers.locations[].ongkir), tersinkron dua arah. Kosong = belum diatur. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Ongkir/galon lokasi ini (Rp)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOngkirRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="7" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOngkirDefaultRow"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="↺ Pakai default"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHitungOngkirRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Harga khusus LOKASI ini per produk — SAMA dengan field harga per lokasi di form web
             (customers.locations[].prices), tersinkron dua arah. Seksi terlipat; ketuk header untuk
             membuka. Header menampilkan jumlah harga yang diatur. Baris per produk diisi dari kode
             (CustomerFormActivity#buildLocationPriceFields); petunjuk abu-abu di tiap kolom = harga
             yang berlaku bila kolom dikosongkan (harga pelanggan, lalu harga standar). -->
        <TextView
            android:id="@+id/tvLokasiHargaHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="▸ Harga khusus lokasi ini (opsional)"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llLokasiHarga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hanya berlaku untuk order yang dikirim ke lokasi ini. Kosongkan = ikut harga abu-abu di kolom (harga pelanggan, atau harga standar)."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/llLokasiHargaRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Koleksi foto lokasi (maks 5): thumbnail bisa dihapus (✕) + tombol "+ Foto" mengambil
             foto baru & mengunggahnya. Diisi/dirender dari kode (jumlah foto berubah-ubah). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Foto Lokasi"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llLokasiFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
