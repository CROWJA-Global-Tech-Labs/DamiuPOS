<?xml version="1.0" encoding="utf-8"?>
<!-- 🛵 Mode Keliling (layar penuh): 2/3 atas = kepala + 10 pelanggan terdekat, 1/3 bawah = peta live.
     Warna eksplisit (app light-only): putih di atas #BF360C = 5,6:1; teks #37474F di atas #ECEFF1 = 8,6:1. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEFF1"
    android:orientation="vertical"
    android:weightSum="3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#BF360C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="2dp">

            <!-- Satu baris: judul · status GPS · Keluar (kepala setipis mungkin, daftar dapat ruang). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="🛵 Mode Keliling"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIderStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="📡 Mencari…"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- Dropdown tampilan daftar: radius + jumlah maks (popup slider). Teks #BF360C di atas putih = 5,6:1. -->
            <TextView
                android:id="@+id/tvIderView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_ider_view_chip"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:text="📏 100 m · 10 ▾"
                android:textColor="#BF360C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIderExit"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:contentDescription="Keluar"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="44dp"
                android:minWidth="44dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="✕"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:rippleColor="#40FFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tvIderEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="28dp"
                android:text="⏳ Memuat pelanggan…"
                android:textColor="#37474F"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#BF360C"
        android:paddingTop="3dp">

        <WebView
            android:id="@+id/webIder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
