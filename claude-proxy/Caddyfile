202-155-157-70.domainesia.io {
    encode zstd gzip

    # Static file downloads (APK builds, etc). Files live in ./downloads on the
    # host, mounted read-only into the caddy container at /srv/downloads.
    # URL: https://202-155-157-70.domainesia.io/dl/<filename>
    handle_path /dl/* {
        root * /srv/downloads
        file_server browse
    }

    # DAMIU POS WA inbox parser proxy → claude-proxy container.
    # Bearer-token auth handled inside the proxy itself.
    handle /parse-order {
        reverse_proxy claude-proxy:3000
    }
    handle /healthz {
        reverse_proxy claude-proxy:3000
    }

    # Everything else falls through to n8n.
    handle {
        reverse_proxy n8n:5678
    }
}
